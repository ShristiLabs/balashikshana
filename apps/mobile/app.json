{
  "expo": {
    "name": "Balashikshana",
    "slug": "balashikshana",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "balashikshana",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shristilabs.balashikshana"
    },
    "android": {
      "package": "com.shristilabs.balashikshana"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#58CC02",
          "dark": { "backgroundColor": "#14211F" }
        }
      ]
    ]
  }
}
