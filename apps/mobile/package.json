{
  "name": "@balashikshana/mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "npx expo start",
    "web": "node ./server.mjs",
    "ios": "npx expo start --ios",
    "android": "npx expo start --android",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "expo": "~58.0.0",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.9.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  }
}
