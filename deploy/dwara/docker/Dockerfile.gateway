# balashikshana edge gateway image (issue #65) — OPERATOR-SIDE build,
# never built by CI (validate-only doctrine; no image pushes in the
# pipeline). Build context: the repository root, with the ShristiLabs/dwara
# checkout available at ./dwara-src (see deploy/dwara/README.md):
#
#   docker build -f deploy/dwara/docker/Dockerfile.gateway \
#     --build-arg DWARA_ENV=staging \
#     --build-arg ACCOUNT_ID=... --build-arg AWS_REGION=us-east-1 \
#     -t $ECR/balashikshana-staging/gateway:latest .
#
# Stage 1 builds the upstream gateway binary exactly as the dwara repo
# ships it (static musl, FROM scratch pattern — Dockerfile.scratch).
# Stage 2 adds the balashikshana env config and an entrypoint that writes
# the SSM-injected TLS material (env vars -> files) before exec'ing dwara:
# ECS Fargate can inject secrets as ENV, and Dwara reads certs from files,
# so the entrypoint is the bridge. Cert/key values never live in the image.

ARG RUST_VERSION=1.94-alpine

FROM rust:${RUST_VERSION} AS builder
RUN apk add --no-cache musl-dev cmake make perl
WORKDIR /build
COPY dwara-src/Cargo.toml dwara-src/Cargo.lock dwara-src/rust-toolchain.toml ./
COPY dwara-src/crates/ crates/
ARG TARGETARCH
RUN case "${TARGETARCH:-$(uname -m | sed 's/aarch64/arm64/;s/x86_64/amd64/')}" in \
        amd64) echo 'x86_64-unknown-linux-musl' > /target.triple ;; \
        arm64) echo 'aarch64-unknown-linux-musl' > /target.triple ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac
RUN rustup target add "$(cat /target.triple)"
# OSS build: redirect the private licensing-core git pin to an inert stub
# (same rationale as the upstream Dockerfile.scratch — the ent feature is
# off; cargo still resolves every locked source).
RUN REV=$(sed -n 's/.*licensing.git", rev = "\([0-9a-f]*\)".*/\1/p' Cargo.toml) \
    && VER=$(awk '/name = "licensing-core"/{getline; sub(/^version = /,""); gsub(/"/,""); print; exit}' Cargo.lock) \
    && mkdir -p third-party/licensing-core/src .cargo \
    && printf '[package]\nname = "licensing-core"\nversion = "%s"\nedition = "2021"\npublish = false\n\n[lib]\npath = "src/lib.rs"\n' "$VER" > third-party/licensing-core/Cargo.toml \
    && : > third-party/licensing-core/src/lib.rs \
    && printf '{"files":{}}' > third-party/licensing-core/.cargo-checksum.json \
    && printf '[source."git+https://github.com/ShristiLabs/licensing.git?rev=%s"]\ngit = "https://github.com/ShristiLabs/licensing.git"\nrev = "%s"\nreplace-with = "oss-stub-licensing"\n\n[source.oss-stub-licensing]\ndirectory = "/build/third-party"\n' "$REV" "$REV" > .cargo/config.toml
RUN cargo build --release --target "$(cat /target.triple)" --bin dwara -p dwara-bin

FROM alpine:3.20 AS config
ARG DWARA_ENV=staging
# The env config ships in this repo (validated by the test suite); the
# image bakes exactly one environment, selected at build time.
COPY deploy/dwara/envs/${DWARA_ENV}.yaml /etc/dwara/dwara.yaml

# Final stage: alpine rather than the upstream FROM scratch — the
# entrypoint needs a shell to bridge ECS env-injected TLS material into
# the PEM files Dwara reads, and busybox wget gives the task definition a
# zero-extra-dependency /healthz container health check. The dwara binary
# is static musl and runs unchanged.
FROM alpine:3.20
COPY --from=builder /build/target/*/release/dwara /usr/local/bin/dwara
COPY --from=config /etc/dwara/dwara.yaml /etc/dwara/dwara.yaml
COPY deploy/dwara/docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh /usr/local/bin/dwara \
    && mkdir -p /etc/dwara/certs /var/lib/dwara \
    && chown -R 65532:65532 /etc/dwara /var/lib/dwara /entrypoint.sh
ENV DWARA_CONFIG=/etc/dwara/dwara.yaml
# UID 65532 matches the upstream nonroot convention.
USER 65532:65532
ENTRYPOINT ["/entrypoint.sh"]
