{
  "uid": "balashi-api-overview",
  "title": "Balashikshana API - Observability (first-party)",
  "description": "Origin API overview from the internal metrics listener (issue #66). No child PII is present in any metric by construction (docs/observability.md).",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by route class (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (route_class) (rate(http_requests_total[5m]))",
          "legendFormat": "{{route_class}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 latency by route class (SLO 500ms)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route_class) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route_class}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 0.5 },
          { "color": "red", "value": 0.8 }
        ] } },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx error ratio (alert > 1% for 10m)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status_class=\"5xx\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 0.001)",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Sync success vs error by endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (endpoint, outcome) (rate(sync_requests_total[5m]))",
          "legendFormat": "{{endpoint}} {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Gate evaluation outcomes (engine pass/fail)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(gate_evaluate_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Captured error events by outcome (flood-capped included)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(error_events_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "DB pool (total/idle/waiting; saturation alert > 5 waiting)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "expr": "db_pool_total", "legendFormat": "total", "refId": "A" },
        { "expr": "db_pool_idle", "legendFormat": "idle", "refId": "B" },
        { "expr": "db_pool_waiting", "legendFormat": "waiting", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Cardinality guard: rejected observations (should be flat 0)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "description": "Any sustained non-zero value means label-guard rejections (or an attack attempting label explosion). Investigate via docs/observability.md.",
      "targets": [
        {
          "expr": "metrics_observations_rejected_total",
          "legendFormat": "{{metric}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    }
  ]
}
