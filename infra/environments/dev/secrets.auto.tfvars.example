# Copy to secrets.auto.tfvars (gitignored) ONLY if you prefer tfvars over
# SSM for a local plan. The committed configuration expects all secrets in
# SSM Parameter Store:
#
#   /balashikshana/dev/db_master_password   (SecureString, pre-created)
#   /balashikshana/dev/smtp_user            (SecureString, pre-created)
#   /balashikshana/dev/smtp_pass            (SecureString, pre-created)
#   /balashikshana/dev/database_url         (SecureString, managed by Terraform)
#   /balashikshana/dev/edge_tls_cert        (SecureString, gateway public listener cert PEM, #65)
#   /balashikshana/dev/edge_tls_key         (SecureString, gateway public listener key PEM, #65)
#   /balashikshana/dev/edge_tls_client_ca   (SecureString, admin mTLS client CA bundle PEM, #65)
#   /balashikshana/dev/edge_key_parent      (SecureString, parent-app consumer class key, #65)
#   /balashikshana/dev/edge_key_child_device (SecureString, child-device consumer class key, #65)
#   /balashikshana/dev/edge_key_portal      (SecureString, portal consumer class key, #65)
#
# This example intentionally contains NO real values; the secret-scan test
# treats literal secret assignments as a failure.
