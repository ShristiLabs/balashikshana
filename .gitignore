# Dependencies
node_modules/
.pnp
.pnp.js

# Mobile / Expo / React Native / Flutter
.expo/
dist/
web-build/
ios/Pods/
android/.gradle/
android/app/build/
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# Environment & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Terraform (issue #64): state, provider caches, and secret var files are
# NEVER committed. *.auto.tfvars carries per-env overrides that may include
# credentials — this ignore rule + the infra secret-scan test are the two
# enforced layers (docs/deployment.md "Secrets").
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.auto.tfvars
*.auto.tfvars.json
crash.log

# Logs & OS
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Coverage & Temp
coverage/
tmp/
temp/
.pids/
logs/
services/api/data/

# SDLC runtime state (delivery-flow status files; not product code)
.sdlc/

# Content-pack compiler output (issue #46): rebuilt from the registry via
# tools/content-pipeline; the manifest index and pack artifacts are served
# by the API from this directory but never committed.
services/api/content-packs/

# Dwara edge gateway dev TLS material (#65): generated by
# deploy/dwara/gen-dev-certs.sh — key material is NEVER committed
# (also enforced by the infra secret-scan test).
deploy/dwara/certs/
